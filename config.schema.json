{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://humanet.dev/schemas/config-v1.0.json",
  "title": "Humanet Configuration",
  "description": "Schema for validating .humanet/config.yml files",
  "type": "object",
  "required": ["humanet"],
  "properties": {
    "humanet": {
      "type": "object",
      "required": ["version", "name", "status", "domains", "maintainers", "repository_url"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+$",
          "description": "Version of the Humanet specification",
          "examples": ["1.0"]
        },
        "id": {
          "type": "string",
          "description": "Unique identifier (auto-generated by platform)",
          "examples": ["idea-12345-abcdef"]
        },
        "name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "Name of the idea"
        },
        "tagline": {
          "type": "string",
          "maxLength": 200,
          "description": "Brief one-line description"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "description": "Detailed description"
        },
        "created": {
          "type": "string",
          "format": "date",
          "description": "Creation date (ISO 8601 format)"
        },
        "updated": {
          "type": "string",
          "format": "date",
          "description": "Last update date"
        },
        "status": {
          "type": "string",
          "enum": ["provisional", "validated", "active", "dormant", "archived", "deprecated"],
          "description": "Current lifecycle status"
        },
        "status_history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["status", "date"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["provisional", "validated", "active", "dormant", "archived", "deprecated"]
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "provisional_deadline": {
          "type": "string",
          "format": "date",
          "description": "Deadline for provisional validation"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "ai-ml",
              "blockchain",
              "climate-tech",
              "dev-tools",
              "education",
              "finance",
              "healthcare",
              "knowledge-management",
              "productivity",
              "research-tools",
              "social-impact",
              "web3",
              "other"
            ]
          },
          "description": "Primary domains (2-5 recommended)"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 50
          },
          "description": "Free-form tags"
        },
        "maintainers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["username", "role", "joined"],
            "properties": {
              "username": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "role": {
                "type": "string",
                "enum": ["creator", "maintainer", "admin"]
              },
              "joined": {
                "type": "string",
                "format": "date"
              },
              "karma": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["username", "role", "joined"],
            "properties": {
              "username": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "role": {
                "type": "string",
                "examples": ["developer", "designer", "researcher", "writer"]
              },
              "joined": {
                "type": "string",
                "format": "date"
              },
              "karma": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "parent": {
          "type": ["string", "null"],
          "description": "Parent idea ID if this is a fork"
        },
        "forks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "url", "created"],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "created": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "relationship"],
            "properties": {
              "id": {
                "type": "string"
              },
              "relationship": {
                "type": "string",
                "enum": ["complements", "depends-on", "inspired-by", "supersedes"]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "last_evaluated": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "evaluation_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 10
        },
        "validation_status": {
          "type": "string",
          "enum": ["pending", "passed", "needs-refinement", "failed"]
        },
        "evaluation_criteria": {
          "type": "object",
          "properties": {
            "clarity": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 10
            },
            "feasibility": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 10
            },
            "impact": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 10
            },
            "originality": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 10
            },
            "completeness": {
              "type": ["number", "null"],
              "minimum": 0,
              "maximum": 10
            }
          }
        },
        "ai_feedback": {
          "type": ["string", "null"]
        },
        "platform_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "repository_url": {
          "type": "string",
          "format": "uri",
          "description": "GitHub/GitLab repository URL"
        },
        "links": {
          "type": "object",
          "properties": {
            "website": {
              "type": "string",
              "format": "uri"
            },
            "documentation": {
              "type": "string",
              "format": "uri"
            },
            "demo": {
              "type": "string",
              "format": "uri"
            },
            "prototype": {
              "type": "string",
              "format": "uri"
            },
            "discussion": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "license": {
          "type": "string",
          "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "MIT", "Unlicense", "Apache-2.0"],
          "description": "License for idea documentation"
        },
        "accepting_contributions": {
          "type": "boolean"
        },
        "contribution_guidelines": {
          "type": "string",
          "format": "uri"
        },
        "contact": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email"
            },
            "discord": {
              "type": "string"
            },
            "twitter": {
              "type": "string"
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "last_commit": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "commit_count": {
              "type": "integer",
              "minimum": 0
            },
            "views": {
              "type": "integer",
              "minimum": 0
            },
            "stars": {
              "type": "integer",
              "minimum": 0
            },
            "forks": {
              "type": "integer",
              "minimum": 0
            },
            "contributors_count": {
              "type": "integer",
              "minimum": 0
            },
            "discussions_count": {
              "type": "integer",
              "minimum": 0
            },
            "total_karma_distributed": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
